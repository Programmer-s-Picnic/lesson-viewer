{
  "name": "learn-with-champak-python-editor",
  "version": "1.0.0",
  "description": "Learn With Champak offline Python Editor for Windows",
  "author": "Champak Roy",
  "license": "UNLICENSED",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:win": "electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "^38.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "live.learnwithchampak.pythoneditor",
    "productName": "Learn With Champak Python Editor",
    "artifactName": "PythonEditorSetup-${version}.${ext}",
    "asar": true,
    "files": ["main.cjs", "package.json"],
    "extraResources": [
      {
        "from": "../python-starter/editor/super",
        "to": "editor",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [{"target": "nsis", "arch": ["x64"]}]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Python Editor",
      "uninstallDisplayName": "Learn With Champak Python Editor",
      "deleteAppDataOnUninstall": false
    }
  }
}
